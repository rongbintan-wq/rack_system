# 复制为 .env.local 并按需修改（.env.local 已被 gitignore）
# 环境：dev | prod
ENV=dev
DEBUG=true

# 数据库：初期 SQLite；后期切 MySQL 仅需改此串
# DATABASE_URL=sqlite:///./data/dcim.db
DATABASE_URL=sqlite:///./data/dcim.db

# JWT / 安全
SECRET_KEY=change-me-in-prod-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 默认管理员（仅 DEV 初始化用）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# 鉴权开关：DEV 本地联调可设 false；PROD 必须为 true
REQUIRE_AUTH=false

# CORS：生产环境填具体前端域名，逗号分隔
CORS_ORIGINS=*
